# agentic-graph environment template.
# Copy to .env and fill in real values. Never commit .env.

# Disable Cognee usage telemetry.
TELEMETRY_DISABLED=true
# Where Cognee stores datasets, embeddings, and the step trace file. Use an absolute path.
DATA_ROOT_DIRECTORY=/absolute/path/to/agentic-graph/.cognee_data
# Where Cognee stores internal system state (history, metadata). Use an absolute path.
SYSTEM_ROOT_DIRECTORY=/absolute/path/to/agentic-graph/.cognee_system
# Cognee log level. ERROR keeps the server quiet.
LOG_LEVEL=ERROR
# Base URL of the agentic-graph server, used by agentic_graph.client and ag-watch.
COGNEE_SERVER_URL=http://127.0.0.1:28195

# Cognee provider config
# LLM provider type. "custom" means any OpenAI-compatible endpoint.
LLM_PROVIDER=custom
# OpenAI-compatible chat completions endpoint.
LLM_ENDPOINT=https://your-llm-endpoint.example/v1
# Model name the endpoint serves.
LLM_MODEL=your-model-name
# Embedding provider. "fastembed" runs local sentence embeddings, no API key.
EMBEDDING_PROVIDER=fastembed
# Local embedding model. BAAI/bge-small-en-v1.5 is small and fast.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# How many data points can be embedded at once. Increase if you have CPU headroom.
# EMBEDDING_MAX_CONCURRENT_DATA_POINTS=600
# Disable per-provider embedding rate limits. Useful for fastembed local inference.
# EMBEDDING_RATE_LIMIT_ENABLED=false

# Keys
# API key for LLM_ENDPOINT. Secret. Replace the placeholder.
LLM_API_KEY=your-token-here

# Relational + vector + cache
# Relational database engine.
DB_PROVIDER=postgres
# Postgres host. 127.0.0.1 when you run Postgres with docker compose.
DB_HOST=127.0.0.1
# Postgres port on the host. The compose file maps container 5432 here.
DB_PORT=28196
# Postgres user. Matches docker-compose.yml.
DB_USERNAME=cognee
# Postgres password. Local development only. Change it for anything shared.
DB_PASSWORD=cognee
# Postgres database name. Matches docker-compose.yml.
DB_NAME=cognee_db
# Vector store engine. Embeddings live in Postgres via pgvector.
VECTOR_DB_PROVIDER=pgvector
# Cache backend. "postgres" keeps everything in one database.
CACHE_BACKEND=postgres

# Graph
# Graph engine. "agentic_pggraph" selects the custom Postgres + pgGraph adapter. No Neo4j process.
GRAPH_DATABASE_PROVIDER=agentic_pggraph

# Local Postgres has no TLS, so backend access control stays off.
ENABLE_BACKEND_ACCESS_CONTROL=false

# Code graph extraction
# Path to the enola binary used for code extraction.
ENOLA_PATH=/absolute/path/to/enola
# Extra SQLAlchemy connect args for Postgres, as JSON. Local Postgres has no SSL.
DATABASE_CONNECT_ARGS='{"ssl": false}'

# Optional overrides the code reads. Defaults shown, uncomment to change.
# Bind host for ag-server.
# COGNEE_HOST=127.0.0.1
# Bind port for ag-server.
# COGNEE_PORT=28195
# Cognee dataset name used by /sync, /search, /explore, /correlate.
# COGNEE_DATASET=agentic_graph
# JSONL file where /trace appends agent steps.
# COGNEE_STEPS_FILE=/absolute/path/to/agentic-graph/.cognee_data/agentic_steps.jsonl
# HTTP timeout in seconds for agentic_graph.client.
# COGNEE_TIMEOUT=300
# Hindsight server base URL for ag-migrate.
# HINDSIGHT_API_URL=http://127.0.0.1:28188
# Hindsight bearer token for ag-migrate. Secret. Replace the placeholder.
# HINDSIGHT_API_TOKEN=your-hindsight-token
# Repo path for scripts that ingest without an argument.
# CODE_GRAPH_REPO_PATH=/path/to/repo
